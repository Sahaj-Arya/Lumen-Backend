# ─────────────────────────── server ───────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true
# Comma-separated origins allowed to call the API. Use * only in development.
CORS_ORIGINS=*

# ─────────────────────────── postgres ─────────────────────────
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
PG_POOL_MAX=10

# ─────────────────────────── redis ────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────── auth ─────────────────────────────
# 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Require a verified email before the account can log in.
REQUIRE_EMAIL_VERIFICATION=true

# ─────────────────────────── otp login ────────────────────────
# static = one fixed code accepted for EVERY phone number (development only —
#          this authenticates nobody). sms = real random code via a gateway.
OTP_PROVIDER=static
OTP_STATIC_CODE=111111
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=10
# The API refuses to boot in production on the static provider unless this is
# set. Do not set it.
OTP_ALLOW_INSECURE_IN_PRODUCTION=false

# ─────────────────────────── mail ─────────────────────────────
# console = print the verification link to the log (development default).
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@lumeniot.sahajarya.com
# Where the verification link points (your app or web front end).
PUBLIC_APP_URL=http://localhost:4000

# ─────────────────────────── mqtt bridge ──────────────────────
# The backend is the only MQTT client; the mobile app talks to this API.
# Node can open a raw TLS socket, so the native 8883 endpoint is used here.
MQTT_URL=mqtts://lumeniot.sahajarya.com:8883
MQTT_USERNAME=app
MQTT_PASSWORD=
MQTT_CLIENT_ID=lumen-backend
MQTT_BASE_TOPIC=devices
# Path to the broker's CA. Leave empty to use the system trust store.
MQTT_CA_FILE=
MQTT_ENABLED=true

# ─────────────────────────── telemetry ────────────────────────
# Readings older than this are deleted by the retention sweep.
TELEMETRY_RETENTION_DAYS=30
# A device with no message for this long is reported offline when it has no
# retained status topic of its own.
DEVICE_STALE_SECONDS=180

# ─────────────────────────── limits ───────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
